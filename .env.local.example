# ── Google Drive attachment pipeline (optional) ────────────────────
# When both are set, the "Drive" button on an issue opens the real
# Google Picker. Without them, the app offers a demo Drive attachment
# so the pipeline stays fully usable.
#
# Setup:
#   1. Google Cloud Console → create/select a project
#   2. Enable the "Google Picker API"
#   3. Credentials → create an OAuth 2.0 Client ID (Web application),
#      add your origin (e.g. http://localhost:3100) to Authorized JS origins
#   4. Credentials → create an API key (restrict to Picker API)
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
# Optional: Cloud project number, enables per-app Drive file scoping
VITE_GOOGLE_APP_ID=

# ── Database (wired later; app runs on the seeded store until set) ──
# Paste your Neon connection string here to move off the local seed.
# Server-only: do NOT give this a VITE_ prefix. Vite inlines every VITE_*
# variable into the client bundle, where it would be public.
# DATABASE_URL=

# ── Landing-page "Request access" form ─────────────────────────────
# Server-only: no VITE_ prefix. Submissions are emailed via Resend.
ACCESS_REQUEST_EMAIL=
RESEND_API_KEY=
# ACCESS_REQUEST_FROM="IssueLyst <access@yourdomain.com>"
